# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. HUWAG i-expose sa client / HUWAG i-commit.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 4+ (AI layer)
GEMINI_API_KEY=

# Phase 5 (semantic search) — optional, defaults to 0.55 kung hindi naka-set.
# I-adjust base sa totoong similarity scores na makikita mo sa "Lower
# confidence matches" section ng /search (semantic mode) pagkatapos mong
# subukan ng ilang real queries laban sa totoong content mo.
SEMANTIC_SEARCH_MIN_SIMILARITY=
